# Copia este archivo a `.env` y completa los valores reales.

# URL base del backend.
# Debe ser el ORIGEN del backend (opcionalmente con una ruta base), sin `/api`:
# el cliente agrega `/api` automáticamente. Debe coincidir con el PORT del backend.
# En producción debe ser una URL absoluta (Vercel no tiene proxy para /api).
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
