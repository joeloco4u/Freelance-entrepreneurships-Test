# Copy this file to `.env` and fill in the real values.

# --- Server ---
PORT=3001
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN=http://localhost:5173
# Comma-separated IP whitelist. Leave empty to disable the check.
ALLOWED_IPS=

# Public base URL of the FRONTEND. Used to build the redirect target for the
# password-recovery and invite links (`${APP_URL}/reset-password`).
# This exact URL must also be listed in Supabase Dashboard >
# Authentication > URL Configuration > Redirect URLs.
APP_URL=http://localhost:5173

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email (Resend) ---
# Sends sales/stock notifications and the password-recovery email.
RESEND_API_KEY=re_your_api_key
# Must be an address on a domain verified in Resend.
EMAIL_FROM=Freelance LATAM <no-reply@your-domain.com>

# --- Slack ---
SLACK_WEBHOOK_URL_IT=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_TOKEN_SHEET_URL=https://docs.google.com/spreadsheets/d/your-sheet-id

# --- Google Sheets ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Keep the literal \n escapes on a single line.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key\n-----END PRIVATE KEY-----\n"
